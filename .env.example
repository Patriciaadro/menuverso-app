# Menuverso · server-side environment variables for the /api functions.
# Set these in Vercel → Project → Settings → Environment Variables, for BOTH
# Production and Preview, then redeploy. Never commit real values, and never
# put them in index.html: the service-role key bypasses all Row Level Security.
#
# Read by (verified against the source, 20 Oct 2026):
#   api/redeem.js          SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   api/redemptions.js     SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   api/confirm.js         SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   api/member-confirm.js  SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY
#   api/waitlist.js        SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY
# Any function missing the first two answers 500 {"error":"server_not_configured"}.
# Without RESEND_API_KEY the email functions still return 200 but send nothing
# ({"emailed": false}).
#
# The email sender is NOT an env var: it is hardcoded as
#   'Menuverso <info@menuverso.com>'  in api/member-confirm.js and api/waitlist.js
# and menuverso.com must be a verified domain in Resend.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://qjrqnnrucdvpwrbkxean.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (sending access is enough)
RESEND_API_KEY=
